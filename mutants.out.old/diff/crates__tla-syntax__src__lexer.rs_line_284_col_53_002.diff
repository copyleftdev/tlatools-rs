+            if best.is_none_or(|found| symbol.len() >= /* ~ changed by cargo-mutants ~ */ found.len()) {
                 best = Some(symbol);
             }
         }
         let symbol = best?;
         self.advance(symbol.chars().count());
         Some(Tok::Op(Op::User(symbol)))
     }
 
