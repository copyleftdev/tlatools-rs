 pub(crate) fn push(ctx: &mut Ctx<'_, '_>, binding: &[(String, Value)]) -> usize {
     let restore = ctx.locals.len();
     for (name, value) in binding {
         ctx.locals.push((name.clone(), Local::Val(value.clone())));
     }
