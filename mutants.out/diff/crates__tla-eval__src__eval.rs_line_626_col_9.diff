     fn unchanged(&self, e: &'m Expr, ctx: &mut Ctx<'m, '_>) -> Result<Value> {
         let before = self.eval(e, ctx)?;
         let after = self.primed(e, ctx)?;
         Ok(Value::Bool(before == after))
