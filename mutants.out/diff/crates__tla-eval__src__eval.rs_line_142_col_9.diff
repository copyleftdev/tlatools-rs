     pub(crate) fn eval_bool(&self, e: &'m Expr, ctx: &mut Ctx<'m, '_>) -> Result<bool> {
         match self.eval(e, ctx)? {
             Value::Bool(b) => Ok(b),
             other => type_error(format!("expected a boolean, got {other}")),
         }
     }
