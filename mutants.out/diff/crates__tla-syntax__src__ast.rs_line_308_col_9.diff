     fn fold(items: Vec<Expr>, op: Op) -> Expr {
         let mut iter = items.into_iter();
         let first = iter.next().expect("junction list has at least one item");
         iter.fold(first, |acc, e| Expr::Binary(op, Box::new(acc), Box::new(e)))
     }
